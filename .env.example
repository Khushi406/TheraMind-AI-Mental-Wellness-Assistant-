# TheraMind AI - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Get free database at: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@localhost:5432/theramind_db"


# ═══════════════════════════════════════════════════════════
# AI API KEYS (At least one required)
# ═══════════════════════════════════════════════════════════

# Google Gemini API (Primary for emotion analysis)
# Get free API key: https://ai.google.dev/
GEMINI_API_KEY="your_gemini_api_key_here"

# Backup Gemini API Key (optional, for rate limit failover)
GEMINI_API_KEY_BACKUP=""

# Groq API (Recommended for AI chat - fast & free)
# Get free API key: https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"


# ═══════════════════════════════════════════════════════════
# SESSION & SECURITY
# ═══════════════════════════════════════════════════════════

# Session secret for Express Session (minimum 32 characters)
# Generate strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your_long_random_secret_string_minimum_32_characters"


# ═══════════════════════════════════════════════════════════
# OPTIONAL: LEGACY API KEYS
# ═══════════════════════════════════════════════════════════

# Hugging Face API (Legacy, not actively used)
HUGGINGFACE_API_KEY=""

# Anthropic Claude API (Legacy, not actively used)
ANTHROPIC_API_KEY=""


# ═══════════════════════════════════════════════════════════
# ENVIRONMENT
# ═══════════════════════════════════════════════════════════

# Node environment (development, production, test)
NODE_ENV="development"


# ═══════════════════════════════════════════════════════════
# INSTRUCTIONS
# ═══════════════════════════════════════════════════════════
#
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys and database URL
# 3. Never commit .env to version control (already in .gitignore)
# 4. Restart server after changing environment variables
#
# Need help getting API keys?
# - Gemini: https://ai.google.dev/ (Free tier: 60 requests/minute)
# - Groq: https://console.groq.com/ (Free tier: very generous limits)
# - Database: https://neon.tech/ (Free 0.5GB PostgreSQL)
#
# Minimum required for app to work:
# ✓ DATABASE_URL
# ✓ SESSION_SECRET
# ✓ At least one of: GEMINI_API_KEY or GROQ_API_KEY
#
